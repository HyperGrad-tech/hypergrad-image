---
const isHome = Astro.url.pathname === '/en/' || Astro.url.pathname === '/en';
import { getSisterSitesEn } from '../data/sisterSites-en';
const sisters = getSisterSitesEn('image');
---
<header class="header">
  <a href="/en/" class="header-logo">
    <div class="logo-mark">▤</div>
    <div>
      HyperGrad
      <div class="logo-sub">Image · Image Toolbox</div>
    </div>
  </a>
  <nav class="header-nav">
    <a href="/en/">All Tools</a>
{sisters.map(s => (
      <a href={s.href} class="nav-sister" target="_blank" rel="noopener" title={s.slogan}>
        <span class="nav-sister-icon">{s.icon}</span>
        <span class="nav-sister-name">{s.shortName}</span>
      </a>
    ))}
    <a href="https://hypergrad.cn" target="_blank" rel="noopener">DeepSeal</a>
    <a href="https://hypergrad.cn#pricing" target="_blank" rel="noopener" class="header-cta">Download DeepSeal</a>
  </nav>
</header>
