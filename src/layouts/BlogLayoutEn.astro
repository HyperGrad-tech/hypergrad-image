---
import '../styles/global.css';
import HeaderEn from '../components/HeaderEn.astro';
import FooterEn from '../components/FooterEn.astro';

export interface Props {
  title: string;
  description: string;
  publishDate: string;
  updatedDate?: string;
  author?: string;
  readingTime?: string;
}

const { title, description, publishDate, updatedDate, author = 'HyperGrad Team', readingTime } = Astro.props;
const siteUrl = 'https://image.hypergrad.cn';
const canonicalUrl = `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}/`;

// Article schema for SEO
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'datePublished': publishDate,
  'dateModified': updatedDate || publishDate,
  'author': { '@type': 'Organization', 'name': author },
  'publisher': { '@type': 'Organization', 'name': 'HyperGrad' },
  'url': canonicalUrl,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | HyperGrad Image Blog</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <meta property="og:title" content={`${title} | HyperGrad Image Blog`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="en_US" />
  <meta property="article:published_time" content={publishDate} />
  <meta property="article:author" content={author} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="google-site-verification" content="UCCA8-g007RZIy8Z1p2OYGcWPEo_1_kj4SzNP9VTJC0" />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline>
var _hmt = _hmt || [];
_hmt.push(['_setCookieDomain', '.hypergrad.cn']);
(function() {
  var hm = document.createElement("script");
  hm.src = "https://hm.baidu.com/hm.js?a778461c432b29b641ee950a9f686a65";
  var s = document.getElementsByTagName("script")[0];
  s.parentNode.insertBefore(hm, s);
})();
  </script>
</head>
<body>
  <div class="promo-banner" id="promo-banner">
    <span>
      <strong>DeepSeal</strong> — Local encrypted notes app. Your privacy, your rules.
      <a href="https://hypergrad.cn#pricing" target="_blank" rel="noopener">Download Free →</a>
    </span>
    <span class="promo-close" onclick="document.getElementById('promo-banner').style.display='none'">×</span>
  </div>

  <HeaderEn />

  <main style="max-width: 720px; margin: 0 auto; padding: 40px 20px;">
    <nav class="breadcrumb" aria-label="Breadcrumb" style="margin-bottom: 24px;">
      <a href="/en/">Home</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/en/blog/">Blog</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current" style="color: var(--text-muted);">{title.substring(0, 40)}{title.length > 40 ? '…' : ''}</span>
    </nav>

    <article>
      <h1 style="font-size: 30px; font-weight: 800; line-height: 1.3; margin-bottom: 16px; color: var(--text);">{title}</h1>
      <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--border-light);">
        <span>📅 {new Date(publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {readingTime && <span style="margin-left: 16px;">⏱ {readingTime}</span>}
        <span style="margin-left: 16px;">✍️ {author}</span>
      </div>

      <div class="blog-content" style="line-height: 1.85; color: var(--text); font-size: 16px;">
        <slot />
      </div>

      <div style="margin-top: 48px; padding: 24px; background: var(--bg-soft); border-radius: 12px;">
        <p style="margin: 0; font-size: 14px; color: var(--text-muted);">Try these tools mentioned in this article — all free, all browser-based:</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">
          <a href="/en/svg-optimize/" class="btn btn-secondary btn-sm">SVG Optimizer</a>
          <a href="/en/svg-to-png/" class="btn btn-secondary btn-sm">SVG to PNG</a>
          <a href="/en/webp-convert/" class="btn btn-secondary btn-sm">WebP Converter</a>
          <a href="/en/exif-remover/" class="btn btn-secondary btn-sm">EXIF Remover</a>
        </div>
      </div>
    </article>
  </main>

  <FooterEn />
</body>
</html>

<style is:global>
  .blog-content h2 {
    font-size: 24px; font-weight: 700; margin: 36px 0 16px; color: var(--text);
  }
  .blog-content h3 {
    font-size: 20px; font-weight: 600; margin: 28px 0 12px; color: var(--text);
  }
  .blog-content p {
    margin: 0 0 16px;
  }
  .blog-content ul, .blog-content ol {
    margin: 0 0 16px; padding-left: 24px;
  }
  .blog-content li {
    margin-bottom: 8px;
  }
  .blog-content pre {
    background: var(--bg-soft); padding: 16px; border-radius: 8px;
    overflow-x: auto; font-size: 14px; margin: 16px 0;
  }
  .blog-content code {
    font-family: var(--font-mono, monospace); font-size: 0.9em;
    background: var(--bg-soft); padding: 2px 6px; border-radius: 4px;
  }
  .blog-content pre code {
    background: none; padding: 0;
  }
  .blog-content a {
    color: var(--blue, #6366F1); text-decoration: underline;
  }
  .blog-content strong {
    font-weight: 700;
  }
  .blog-content blockquote {
    border-left: 4px solid var(--blue, #6366F1);
    padding-left: 16px; margin: 16px 0; color: var(--text-muted);
    font-style: italic;
  }
</style>
