---
import '../styles/global.css';
import HeaderEn from '../components/HeaderEn.astro';
import SidebarEn from '../components/SidebarEn.astro';
import FooterEn from '../components/FooterEn.astro';
import { getTool, type Tool } from '../data/tools-en';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool: Tool | undefined = getTool(slug);

if (!tool) {
  throw new Error(`Tool not found: ${slug}`);
}

const siteUrl = 'https://image.hypergrad.cn';
const enUrl = `${siteUrl}/en/${tool.slug}`;
const zhUrl = `${siteUrl}/${tool.slug}`;

// Related tools (filter out self and non-existent slugs)
const relatedTools = tool.related
  .map(s => getTool(s))
  .filter((t): t is Tool => Boolean(t) && t.slug !== tool.slug);

// ===== Structured Data Schema (merged with @graph in a single ld+json script) =====

// 1. SoftwareApplication
const appSchema = {
  '@type': 'SoftwareApplication',
  'name': tool.name,
  'applicationCategory': 'MultimediaApplication',
  'operatingSystem': 'Web',
  'description': tool.seoDescription,
  'url': enUrl,
  'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
  'publisher': { '@type': 'Organization', 'name': 'HyperGrad' },
};

// 2. BreadcrumbList
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${siteUrl}/en/` },
    { '@type': 'ListItem', 'position': 2, 'name': tool.category, 'item': `${siteUrl}/en/#${tool.category}` },
    { '@type': 'ListItem', 'position': 3, 'name': tool.name, 'item': enUrl },
  ],
};

// 3. FAQPage (only generated when FAQ exists)
const faqSchema = tool.faq.length > 0
  ? {
      '@type': 'FAQPage',
      'mainEntity': tool.faq.map(f => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    }
  : null;

const graphItems = faqSchema
  ? [appSchema, breadcrumbSchema, faqSchema]
  : [appSchema, breadcrumbSchema];

const allSchema = {
  '@context': 'https://schema.org',
  '@graph': graphItems,
};
import { getSisterSitesEn } from '../data/sisterSites-en';
const sisters = getSisterSitesEn('image');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tool.seoTitle}</title>
  <meta name="description" content={tool.seoDescription} />
  <meta name="keywords" content={tool.keywords.join(', ')} />
  <link rel="canonical" href={enUrl} />
  <!-- hreflang: EN ↔ ZH paired -->
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
  <link rel="alternate" hreflang="x-default" href={zhUrl} />
  <meta property="og:title" content={`${tool.name} — HyperGrad Image`} />
  <meta property="og:description" content={tool.seoDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={enUrl} />
  <meta property="og:locale" content="en_US" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Search engine verification -->
  <meta name="google-site-verification" content="UCCA8-g007RZIy8Z1p2OYGcWPEo_1_kj4SzNP9VTJC0" />
  <script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
  <!-- Baidu Tongji (cross-subdomain tracking for hypergrad.cn) -->
  <script is:inline>
var _hmt = _hmt || [];
_hmt.push(['_setCookieDomain', '.hypergrad.cn']);
(function() {
  var hm = document.createElement("script");
  hm.src = "https://hm.baidu.com/hm.js?a778461c432b29b641ee950a9f686a65";
  var s = document.getElementsByTagName("script")[0];
  s.parentNode.insertBefore(hm, s);
})();
  </script>
</head>
<body>
  <!-- DeepSeal promo banner -->
  <div class="promo-banner" id="promo-banner">
    <span>
      <strong>DeepSeal</strong> — Local encrypted notes app. Your privacy, your rules.
      <a href="https://hypergrad.cn#pricing" target="_blank" rel="noopener">Download Free →</a>
    </span>
    <span class="promo-close" onclick="document.getElementById('promo-banner').style.display='none'">×</span>
  </div>

  <HeaderEn />

  <div class="layout">
    <SidebarEn />

    <main class="main">
      <!-- Breadcrumb navigation -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>{tool.category}</span>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{tool.name}</span>
      </nav>

      <!-- Tool header -->
      <div class="tool-header">
        <div class="tool-title-wrap">
          <div class="tool-icon-box">{tool.icon}</div>
          <div>
            <h1 class="tool-title">{tool.name}</h1>
            <p class="tool-desc">{tool.desc}</p>
          </div>
        </div>
        <span class={`tag tag-${tool.priority.toLowerCase()}`}>{tool.priority}</span>
      </div>

      <!-- Tool body (each page passes a React component via slot) -->
      <div class="tool-react-root">
        <slot />
      </div>

      <!-- SEO content area (rich text: principles, comparisons, use cases) -->
      <div class="seo-content">
        <slot name="seo-content" />
      </div>

      <!-- FAQ (auto-rendered from tools-en.ts, sync with FAQPage Schema) -->
      {tool.faq.length > 0 && (
        <section class="faq-section">
          <h2>{tool.shortName} FAQ</h2>
          {tool.faq.map(f => (
            <div class="faq-item">
              <div class="faq-q">{f.q}</div>
              <div class="faq-a">{f.a}</div>
            </div>
          ))}
        </section>
      )}

      <!-- Related tools (auto internal links for SEO link equity) -->
      {relatedTools.length > 0 && (
        <section class="related-section">
          <h2>Related Tools</h2>
          <div class="related-grid">
            {relatedTools.map(rt => (
              <a href={`/en/${rt.slug}`} class="tool-card-home">
                <div class="card-icon">{rt.icon}</div>
                <h3>{rt.name}</h3>
                <p>{rt.desc}</p>
                <div class="card-meta">
                  <span>{rt.category}</span>
                  <span>{rt.priority}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
<!-- CROSS-SITES -->
      <section class="cross-sites-section">
        <h2>More from HyperGrad Ecosystem</h2>
        <div class="cross-sites-grid">
          {sisters.map(s => (
            <a href={s.href} class="cross-site-card" target="_blank" rel="noopener">
              <span class="cross-site-icon">{s.icon}</span>
              <span class="cross-site-info">
                <strong>{s.shortName}</strong>
                <span class="cross-site-hot">{s.hot[0].name} · {s.hot[1].name}</span>
              </span>
              <span class="cross-site-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Privacy badge -->
      <div class="privacy-badge privacy-badge--footer">
        100% Local Processing · Images Never Leave Your Browser
      </div>

    </main>
  </div>

  <FooterEn />
</body>
</html>
