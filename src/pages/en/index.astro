---
import '../../styles/global.css';
import HeaderEn from '../../components/HeaderEn.astro';
import FooterEn from '../../components/FooterEn.astro';
import { tools, priorityMeta, toolsByPriority, type Priority } from '../../data/tools-en';

const priorityOrder: Priority[] = ['P0', 'P1', 'P2'];
const totalTools = tools.length;
import { getSisterSitesEn } from '../../data/sisterSites-en';
const sisters = getSisterSitesEn('image');

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hypergrad.cn/#organization",
      "name": "HyperGrad",
      "url": "https://hypergrad.cn/",
      "description": "HyperGrad is a collection of client-side online tools and a local encrypted notes app, focused on privacy protection and local processing."
    },
    {
      "@type": "WebSite",
      "@id": "https://image.hypergrad.cn/#website-en",
      "url": "https://image.hypergrad.cn/en/",
      "name": "HyperGrad Image — Free Online Image Tools · SVG/WebP/EXIF · 100% Browser-Based",
      "description": "12 specialized image tools: SVG optimizer/editor/converter, WebP converter, EXIF viewer/remover, placeholder generator, Base64 converter, color extractor, image stitcher, GIF frame extractor, format converter. All image processing happens in your browser—nothing is uploaded.",
      "inLanguage": "en",
      "publisher": {
        "@id": "https://hypergrad.cn/#organization"
      }
    }
  ]
};

---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HyperGrad Image — Free Online Image Tools · SVG/WebP/EXIF · 100% Browser-Based</title>
  <meta name="description" content="12 free online image tools: SVG optimizer/editor/converter, WebP converter, EXIF viewer/remover, placeholder generator, Base64 converter, color extractor, image stitcher, GIF frame extractor. 100% browser-based, no upload." />
  <meta name="keywords" content="image tools, svg optimizer, svg to png, webp converter, exif viewer, exif remover, placeholder image, image to base64, color extractor, image stitcher, gif frame extractor, image format converter, avif converter" />
  <link rel="canonical" href="https://image.hypergrad.cn/en/" />
  <!-- hreflang: EN ↔ ZH paired -->
  <link rel="alternate" hreflang="en" href="https://image.hypergrad.cn/en/" />
  <link rel="alternate" hreflang="zh-CN" href="https://image.hypergrad.cn/" />
  <link rel="alternate" hreflang="x-default" href="https://image.hypergrad.cn/" />
  <meta property="og:title" content="HyperGrad Image — Free Online Image Tools" />
  <meta property="og:description" content="12 free online image tools. 100% browser-based, images never leave your browser." />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="google-site-verification" content="UCCA8-g007RZIy8Z1p2OYGcWPEo_1_kj4SzNP9VTJC0" />
  <script is:inline>
var _hmt = _hmt || [];
_hmt.push(['_setCookieDomain', '.hypergrad.cn']);
(function() {
  var hm = document.createElement("script");
  hm.src = "https://hm.baidu.com/hm.js?a778461c432b29b641ee950a9f686a65";
  var s = document.getElementsByTagName("script")[0];
  s.parentNode.insertBefore(hm, s);
})();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
</head>
<body>
  <!-- DeepSeal promo banner -->
  <div class="promo-banner" id="promo-banner">
    <span>
      <strong>DeepSeal</strong> — Local encrypted notes app. Your privacy, your rules.
      <a href="https://hypergrad.cn#pricing" target="_blank" rel="noopener">Download Free →</a>
    </span>
    <span class="promo-close" onclick="document.getElementById('promo-banner').style.display='none'">×</span>
  </div>

  <HeaderEn />

  <main class="main" style="max-width: var(--content-max); margin: 0 auto;">
    <!-- Quick navigation -->
    <section class="quick-nav">
      <div class="quick-nav-title">Quick Access · All {totalTools} Tools</div>
      <div class="quick-nav-chips">
        {tools.map(t => (
          <a href={`/en/${t.slug}`} class="quick-chip">
            <span class="quick-chip-icon">{t.icon}</span>
            <span>{t.name}</span>
          </a>
        ))}
      </div>
    </section>


    <!-- Sections by priority -->
    {priorityOrder.map(p => {
      const list = toolsByPriority(p);
      const meta = priorityMeta[p];
      return (
        <section class="priority-section">
          <div class="priority-header">
            <h2>{meta.label}</h2>
            <span class="priority-tag" style={`background:${meta.bg};color:${meta.color}`}>{p} · {list.length} tools</span>
            <span class="priority-desc">{meta.desc}</span>
          </div>
          <div class="tool-grid">
            {list.map(t => (
              <a href={`/en/${t.slug}`} class="tool-card-home">
                <div class="card-icon">{t.icon}</div>
                <h3>{t.name}</h3>
                <p>{t.desc}</p>
                <div class="card-meta">
                  <span>{t.category}</span>
                  <span>~{t.volume} searches/mo</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

<!-- SISTER-CARDS -->
    <section class="sister-sites-section">
      <h2>Need other tools? Explore our sister sites</h2>
      <p class="sister-section-desc">HyperGrad has 5 tool sites in total, all with local processing and no interference—pick one to explore.</p>
      <div class="sister-cards">
        {sisters.map(s => (
          <a href={s.href} class="sister-card" target="_blank" rel="noopener">
            <div class="sister-card-head">
              <span class="sister-card-icon">{s.icon}</span>
              <div class="sister-card-head-text">
                <strong>{s.shortName}</strong>
                <span class="sister-card-href">{s.href.replace('https://', '')}</span>
              </div>
            </div>
            <p class="sister-card-slogan">{s.slogan}</p>
            <ul class="sister-card-tools">
              {s.hot.slice(0, 5).map(h => (
                <li>{h.name}</li>
              ))}
            </ul>
            <span class="sister-card-cta">Visit {s.shortName} →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- About -->
    <section class="seo-content">
      <h2>About HyperGrad Image</h2>
      <p>
        HyperGrad Image is a collection of fully client-side image tools, featuring <strong>{totalTools} specialized tools</strong> for everyday development and design tasks.
        Unlike other image tool sites, all image processing on this site happens <strong>in your browser</strong>—your SVGs, photos, and GIFs
        are never transmitted over the network to any server. This means:
      </p>
      <ul>
        <li><strong>Privacy & Security</strong>: Process personal photos with EXIF data or commercial design files without worrying about leaks.</li>
        <li><strong>Works Offline</strong>: Once the page loads, you can keep using it without an internet connection.</li>
        <li><strong>Fast</strong>: No network round-trips—every operation responds instantly.</li>
        <li><strong>No Ads</strong>: Currently completely ad-free, focused on the experience.</li>
      </ul>
      <h3>Our Differentiation: Avoiding the TinyPNG Battleground</h3>
      <p>
        This site deliberately avoids the crowded PNG/JPG compression space (where TinyPNG and similar tools dominate) and focuses on three categories with differentiated value:
        <strong>SVG Tools</strong> (optimization, editing, PNG conversion), <strong>Modern Format Conversion</strong> (bidirectional WebP/AVIF), and
        <strong>EXIF Privacy</strong> (viewing and stripping). These three categories naturally align with the privacy-first mindset of <a href="https://hypergrad.cn" target="_blank" rel="noopener">DeepSeal encrypted notes</a>—<strong>your data, your rules</strong>.
      </p>
      <h3>Part of the HyperGrad Ecosystem</h3>
      <p>
        HyperGrad Image belongs to the same ecosystem as <a href="https://devtools.hypergrad.cn" target="_blank" rel="noopener">HyperGrad DevTools</a> and
        <a href="https://hypergrad.cn" target="_blank" rel="noopener">DeepSeal encrypted notes app</a>.
        All three products share the same core philosophy: <strong>local processing, privacy first, data never leaves your device</strong>.
      </p>
    </section>
    <!-- Hero -->
    <section class="home-hero home-hero-compact home-hero-compact--bottom">
      <h1>Free Online Image Tools · <span class="hero-accent">SVG / WebP / EXIF · Images Never Leave Browser</span></h1>
      <div class="privacy-badge">{totalTools} Tools · 100% Local Processing · No Upload · No Storage</div>
    </section>

  </main>

  <FooterEn />

  <style is:global>
    .quick-nav {
      margin: 28px 0 8px;
      padding: 16px 20px;
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .quick-nav-title {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .quick-nav-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: thin;
    }
    .quick-nav-chips::-webkit-scrollbar { height: 6px; }
    .quick-nav-chips::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
    .quick-chip {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 13px;
      color: var(--text);
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .quick-chip:hover {
      background: var(--blue);
      color: #fff;
      border-color: var(--blue);
    }
    .quick-chip-icon { font-size: 14px; }

    .home-hero-compact {
      text-align: center;
      padding: var(--space-xl) var(--space-lg) var(--space-lg);
      margin-bottom: var(--space-xl);
    }
    .home-hero-compact h1 {
      font-family: var(--font-sans);
      font-size: 30px;
      font-weight: 800;
      color: var(--text);
      line-height: 1.3;
      margin: 0 0 var(--space-sm);
      letter-spacing: -0.02em;
    }
    .home-hero-compact .hero-accent {
      color: var(--blue);
    }
    .home-hero-compact .privacy-badge {
      font-size: 13px;
      padding: 6px 16px;
    }

    .sister-sites-section {
      margin: var(--space-xl) 0 var(--space-lg);
      padding-top: var(--space-lg);
      border-top: 1px solid var(--border);
    }
    .sister-sites-section h2 {
      font-size: 22px; font-weight: 700;
      color: var(--text);
      margin: 0 0 6px;
      letter-spacing: -0.01em;
    }
    .sister-section-desc {
      font-size: 14px; color: var(--text-muted);
      margin: 0 0 20px;
    }
    .sister-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .sister-card {
      display: flex; flex-direction: column; gap: 10px;
      padding: 18px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      text-decoration: none;
      color: var(--text);
      transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }
    .sister-card:hover {
      border-color: var(--blue);
      box-shadow: 0 8px 24px rgba(99, 102, 241, 0.15);
      transform: translateY(-2px);
    }
    .sister-card-head {
      display: flex; align-items: center; gap: 12px;
    }
    .sister-card-icon {
      font-size: 22px; line-height: 1;
      width: 44px; height: 44px;
      display: flex; align-items: center; justify-content: center;
      background: var(--blue-bg);
      border-radius: 12px;
      flex-shrink: 0;
    }
    .sister-card-head-text {
      display: flex; flex-direction: column; gap: 2px;
      min-width: 0;
    }
    .sister-card-head-text strong {
      font-size: 16px; font-weight: 700; color: var(--text);
    }
    .sister-card-href {
      font-size: 11px; color: var(--text-muted);
    }
    .sister-card-slogan {
      font-size: 13px; color: var(--text-muted);
      line-height: 1.5; margin: 0;
    }
    .sister-card-tools {
      list-style: none; padding: 0; margin: 4px 0 0;
      display: flex; flex-wrap: wrap; gap: 6px 8px;
    }
    .sister-card-tools li {
      font-size: 12px; color: var(--text);
      background: var(--bg-soft);
      padding: 3px 9px;
      border-radius: 12px;
      white-space: nowrap;
    }
    .sister-card-cta {
      margin-top: auto;
      font-size: 13px; font-weight: 600;
      color: var(--blue);
    }

  </style>
</body>
</html>
